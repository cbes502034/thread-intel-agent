# MongoDB Atlas 連線字串
MONGODB_URL=

# 外部情資 API 金鑰
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# 寫入類端點的 X-API-Key
API_KEY=

# ---- 本機 LLM(Ollama)----
# Ollama 服務位置；Docker 容器內連主機請改 http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
# 第一輪:決定呼叫哪些工具
AGENT_MODEL=qwen2.5:1.5b
# 第二輪:風險判定(LoRA 微調後匯入的模型)
JUDGE_MODEL=threat-intel-judge
# RAG 嵌入模型
EMBED_MODEL=bge-m3
# 關閉 RAG 時設 false(評測對照用)
RAG_ENABLED=true
RAG_TOP_K=3
