# 複製成 .env 後填入實際值。.env 已被 .gitignore 排除,不要提交。

# --- 必要 ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
ANTHROPIC_API_KEY=sk-ant-...
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# 管理端點(POST/DELETE /blocklist)使用的金鑰。
# 自己產一組亂數,例如:python -c "import secrets; print(secrets.token_urlsafe(32))"
# 這把金鑰只放在伺服器端,絕對不要寫進前端程式碼。
ADMIN_API_KEY=

# --- 選填,以下為預設值 ---
# BLOCKLIST_EXPIRE_DAYS=30
# CACHE_TTL_HOURS=24
# RATE_LIMIT_PER_IP=5
# RATE_LIMIT_WINDOW_MINUTES=60
# DAILY_ANALYSIS_BUDGET=200
# EXTERNAL_TIMEOUT_SECONDS=10
# AGENT_MODEL=claude-haiku-4-5
# AGENT_MAX_TOKENS=2500
# AGENT_TEMPERATURE=0
# AGENT_MAX_ITERATIONS=6
